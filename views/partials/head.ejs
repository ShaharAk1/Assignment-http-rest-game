<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="A retro arcade game for learning HTTP and REST by sending real requests to a real server." />
  <title><%= typeof title !== 'undefined' ? title : 'HTTP & REST Game' %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bungee&family=Press+Start+2P&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <% if (typeof extraCss !== 'undefined') { %>
  <link rel="stylesheet" href="<%= extraCss %>" />
  <% } %>
</head>
<body>
  <!-- Theme switch: a checkbox placed before .page so CSS can restyle everything with "~" -->
  <input type="checkbox" id="theme-switch" class="theme-switch" />
  <script src="/js/theme.js"></script>

  <div class="page">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="logo" href="/">REST<span>.exe</span></a>

        <nav class="site-nav" aria-label="Main">
          <ul>
            <li><a href="/" <% if (typeof active !== 'undefined' && active === 'game') { %>aria-current="page"<% } %>>Play</a></li>
            <li><a href="/schemas" <% if (typeof active !== 'undefined' && active === 'schemas') { %>aria-current="page"<% } %>>Schemas</a></li>
          </ul>
        </nav>

        <label for="theme-switch" class="theme-toggle">
          <span class="sr-only">Toggle night mode</span>
          <span class="theme-toggle__track" aria-hidden="true"><span class="theme-toggle__knob"></span></span>
          <span class="theme-toggle__text" aria-hidden="true"><span class="theme-toggle__day">Day</span><span class="theme-toggle__night">Night</span></span>
        </label>
      </div>
    </header>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        <span>★ Insert request</span><span>★ GET · POST · PUT · PATCH · DELETE</span><span>★ 200 OK</span><span>★ 201 Created</span><span>★ 404 Not Found</span><span>★ Now loading: /api</span>
        <span>★ Insert request</span><span>★ GET · POST · PUT · PATCH · DELETE</span><span>★ 200 OK</span><span>★ 201 Created</span><span>★ 404 Not Found</span><span>★ Now loading: /api</span>
      </div>
    </div>
