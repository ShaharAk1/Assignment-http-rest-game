<%- include('partials/head', { title: 'Resource Schemas', extraCss: '/css/schemas.css' }) %>

<main id="main" class="container schemas">
  <header class="section-header">
    <span class="section-header__number">📖</span>
    <h1>The Pantry</h1>
  </header>
  <p class="schemas__lead">Every resource the server knows about, its fields and their types. Use it to build correct request bodies.</p>

  <div class="schemas__grid">
    <% resources.forEach(function(resource, index) { %>
    <section class="schema-card card" aria-labelledby="schema-<%= index %>">
      <header class="schema-card__header">
        <span class="schema-card__icon schema-card__icon--<%= index % 2 === 0 ? 'pink' : 'mint' %>" aria-hidden="true"><%= resource.icon %></span>
        <div>
          <h2 id="schema-<%= index %>"><%= resource.resource %></h2>
          <p class="schema-card__endpoint"><code><%= resource.endpoint %></code></p>
        </div>
        <span class="badge badge--sun"><%= resource.fields.length %> fields</span>
      </header>
      <p class="schema-card__description"><%= resource.description %></p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th scope="col">Field</th><th scope="col">Type</th></tr>
          </thead>
          <tbody>
            <% resource.fields.forEach(function(field) { %>
            <tr>
              <td><code><%= field.name %></code></td>
              <td><span class="type-chip type-chip--<%= field.type.split(' ')[0] %>"><%= field.type %></span></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
    <% }); %>
  </div>

  <a class="btn btn--primary btn--pixel schemas__back" href="/"><span class="glyph">▶</span> Back to the kitchen</a>
</main>

<%- include('partials/footer') %>
